{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Context",
  "version": "0.3.0",
  "identifier": "com.context.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Context",
    "shortDescription": "Answers for what's on your screen",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "models/text-detection.onnx": "models/text-detection.onnx",
      "models/text-recognition.onnx": "models/text-recognition.onnx"
    }
  }
}
